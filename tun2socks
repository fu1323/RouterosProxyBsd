#!/bin/sh

# PROVIDE: tun2socks
# REQUIRE: xray
# BEFORE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name="tun2socks"
rcvar="${name}_enable"
pidfile="/var/run/${name}.pid"
command="/home/admin/mysocks/tun2socks"
command_args="-device tun0 -proxy socks5://localhost:1080&"

# 启动前等待xray服务
start_precmd="tun2socks_prestart"
tun2socks_prestart()
{
    echo "Waiting for xray service to be ready..."
    sleep 5
    
    # 检查xray是否在运行
    if ! sockstat -l -4 | grep -q :1080; then
        echo "ERROR: xray service is not listening on port 1080"
        return 1
    fi
}

# 停止命令
stop_cmd="tun2socks_stop"
tun2socks_stop()
{
    if [ -f "${pidfile}" ]; then
        kill $(cat ${pidfile}) 2>/dev/null
        rm -f "${pidfile}"
    fi
    # 确保进程被终止
    pkill -f "tun2socks.*tun0" 2>/dev/null
}

load_rc_config $name
run_rc_command "$1"
